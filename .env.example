# Vannevar Bridge 环境变量配置
# 复制此文件为 .env 并修改以下配置

# 服务端口与绑定地址
# 生产环境公网访问：BRIDGE_BIND_ADDR=0.0.0.0
# 本地访问（默认）：BRIDGE_BIND_ADDR=127.0.0.1
BRIDGE_PORT=8000
BRIDGE_BIND_ADDR=127.0.0.1

# 管理员凭据（必须修改！留空则 docker-compose 启动失败）
BRIDGE_ADMIN_USER=admin
BRIDGE_ADMIN_PASS=

# JWT 密钥（必须设置！留空则 docker-compose 启动失败）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_JWT_SECRET=

# JWT 过期天数
BRIDGE_JWT_EXPIRE_DAYS=7

# 资源限制
BRIDGE_MEM_LIMIT=512m
BRIDGE_CPUS=1.0

# AI 配置（可选，不配置则使用规则引擎）
# 支持的提供商：OpenAI 兼容 API / Anthropic / 自定义端点
BRIDGE_AI_BASE_URL=
BRIDGE_AI_API_KEY=
BRIDGE_AI_MODEL=
