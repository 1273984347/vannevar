# Vannevar Bridge 环境变量配置
# 复制此文件为 .env 并修改以下配置
#
# 说明：本文件列出 Bridge **实际读取的全部**环境变量。
# 未配置的项一律走代码内置的默认值（括号内为默认值）。

# ---- 服务监听 ----
BRIDGE_PORT=8000
BRIDGE_BIND_ADDR=127.0.0.1
# BRIDGE_PORT / BRIDGE_BIND_ADDR 仅在 `python main.py` 直接启动时生效；
# 用 `uvicorn main:app --host ... --port ...` 时由 uvicorn 参数决定。

# ---- 管理员凭据（必填）----
# 不设置时服务会拒绝启动（而不是带着弱口令运行）。
BRIDGE_ADMIN_USER=admin
BRIDGE_ADMIN_PASS=
# 生成强密码：python -c "import secrets; print(secrets.token_urlsafe(16))"

# ---- JWT ----
# 生产环境必须设置为强随机值，否则服务拒绝启动。
BRIDGE_JWT_SECRET=
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_JWT_EXPIRE_DAYS=7

# ---- 调试模式 ----
# BRIDGE_DEBUG=1 时：生成随机 dev 管理员密码并打印到 stderr、开放 /demo 等调试入口。
# 生产环境务必保持为 0 或不设置。
BRIDGE_DEBUG=0

# ---- 数据库 ----
# 默认 sqlite:///bridge_mvp.db（运行目录下生成）。
# 可切换到 PostgreSQL：postgresql://user:pass@localhost:5432/vannevar
# 备份目录会放在数据库文件同级的 backups/ 下（Docker 部署时即 /app/data/backups）。
BRIDGE_DATABASE_URL=
# 滚动备份保留份数（1-100）
BRIDGE_MAX_BACKUPS=7

# ---- 反向代理与 Host 校验 ----
# 受信任代理的 IP / 网段（逗号分隔），用于正确解析 X-Forwarded-For
BRIDGE_TRUSTED_PROXIES=
# 允许的 Host 头（逗号分隔），用于 Host 注入防御
BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1
# 站点对外基础 URL（用于生成二维码等绝对链接），留空则自动推断
BRIDGE_BASE_URL=

# ---- 时区 ----
# Agent 定时扫描与统计所用的时区
BRIDGE_TIMEZONE=Asia/Shanghai

# ---- 二维码 token 枚举限流 ----
# 同一 token 在窗口内允许的失败次数
BRIDGE_QR_TOKEN_FAIL_LIMIT=5
# 限流窗口（秒）
BRIDGE_QR_TOKEN_FAIL_WINDOW=300
# 限流状态表最多保留的 key 数
BRIDGE_QR_TOKEN_FAIL_MAX_KEYS=5000

# ---- AI 增强（可选，不配置则使用本地规则引擎）----
# 支持 OpenAI 兼容 API / Anthropic / 自定义端点
BRIDGE_AI_BASE_URL=
BRIDGE_AI_API_KEY=
BRIDGE_AI_MODEL=
# 设为 1 时 AI 输出走演示模式（用于离线演示，不发起真实请求）
BRIDGE_AI_DEMO_MODE=0

# ---- Docker 资源限制（供 docker-compose 读取）----
BRIDGE_MEM_LIMIT=512m
BRIDGE_CPUS=1.0
